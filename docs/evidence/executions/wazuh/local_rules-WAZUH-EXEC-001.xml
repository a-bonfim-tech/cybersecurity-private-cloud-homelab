<!-- Custom Wazuh SIEM Detection Rules for Homelab -->
<group name="local,syslog,sshd,network_security,">

  <rule id="100001" level="10">
    <if_sid>5716</if_sid>
    <srcip>10.10.30.0/24</srcip>
    <description>SECURITY ALERT: SSH Authentication Failed from Cyber Lab Zone (VLAN 30)</description>
    <mitre>
      <id>T1110</id>
      <id>T1021.004</id>
    </mitre>
  </rule>

  <rule id="100002" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <description>CRITICAL: High Frequency SSH Brute-Force / Reconnaissance Attack from VLAN 30</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- Correlates a Suricata EVE JSON event for SID 1000001. Native logtest
       evidence is retained; operating-manager effectiveness is not claimed. -->
  <rule id="100010" level="7">
    <if_sid>86601</if_sid>
    <field name="event_type">^alert$</field>
    <field name="alert.signature_id">^1000001$</field>
    <description>Suricata detected repeated synthetic VLAN30 SYN reconnaissance toward VLAN20</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

</group>
